{
  "name": "cplayout",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node tools/patch_xcode_uuid_dependency.cjs",
    "start": "npm run start -w @cplayout/mobile",
    "web": "npm run web -w @cplayout/mobile",
    "android": "npm run android -w @cplayout/mobile",
    "export:web": "npm run export:web -w @cplayout/mobile",
    "test:web:e2e": "playwright test --config playwright.config.ts",
    "proof:web": "npm run export:web && npm run test:web:e2e",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate:skills": "python3 tools/validate_cplayout_skills.py",
    "validate": "npm run typecheck && npm test",
    "audit:moderate": "npm audit --audit-level=moderate",
    "check:android-tools": "tsx tools/check_android_tools.ts",
    "verify:android-native": "tsx tools/verify_android_native.ts",
    "verify:loop-ledger": "tsx tools/verify_continuous_improvement_ledger.ts",
    "verify:release": "npm run validate && git diff --check && npm run validate:skills && npm run check:android-tools && npm run verify:android-native"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "tsx": "4.22.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
